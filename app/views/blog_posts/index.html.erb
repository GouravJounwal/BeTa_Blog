<h1>hello </h1>
<h1><%= link_to "New Blog Post", new_blog_post_path %> </h1>

<% @blog_post.each do |blog_post| %>
    
    <p><%= link_to blog_post.title, blog_post_path(blog_post.id) %></p>
    <p><%= blog_post.body %></p>
    <% if blog_post.draft? %>
    <div class="bg-gray-200 rounded text-violet-500">Draft</div>
    <% elsif  blog_post.scheduled?%>
    <div class="bg-gray-200 rounded text-violet-500">Scheduled</div>
    <% else %>
    <div class="bg-gray-200 rounded text-violet-500">Published</div>
    <% end %>
<% end %>
